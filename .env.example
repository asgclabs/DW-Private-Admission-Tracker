# MongoDB connection string.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/?replicaSet=rs0   (a replica set is required)
DATABASE_URL=""
MONGODB_DB="dw_private"

# Razorpay API keys (Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Razorpay webhook secret (Dashboard > Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=""

# First super-admin, created once by `npm run db:seed`.
# After that, manage admins at /admin/users — these are only a bootstrap.
ADMIN_EMAIL="admin@doonwinner.in"
ADMIN_PASSWORD="change-this-strong-password"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
